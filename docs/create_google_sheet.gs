function createComposerDirectorySheet() {
  const ss = SpreadsheetApp.create("Catalogue Compositeurs/Éditeurs - Europe");
  const raw = ss.getActiveSheet();
  raw.setName("data_raw");
  raw.getRange(1,1,DATA_RAW.length,DATA_RAW[0].length).setValues(DATA_RAW);
  raw.setFrozenRows(1);
  raw.getRange(1,1,1,4).createFilter();

  const web = ss.insertSheet("data_web");
  const headers = [["slug","region","pays","type","nom","title","description"]];
  web.getRange(1,1,1,headers[0].length).setValues(headers);
  web.setFrozenRows(1);
  const last = DATA_RAW.length;
  if (last > 1) {
    web.getRange(2,1,last-1,1).setFormulaR1C1('=IF(data_raw!RC1="","",LOWER(REGEXREPLACE(SUBSTITUTE(NORMALIZE(data_raw!RC2&"-"&data_raw!RC3&"-"&data_raw!RC4, "NFD"),"\\pM",""),"[^a-zA-Z0-9]+","-")))');
    web.getRange(2,2,last-1,1).setFormulaR1C1('=IF(data_raw!RC1="","",data_raw!RC1)');
    web.getRange(2,3,last-1,1).setFormulaR1C1('=IF(data_raw!RC1="","",data_raw!RC2)');
    web.getRange(2,4,last-1,1).setFormulaR1C1('=IF(data_raw!RC1="","",data_raw!RC3)');
    web.getRange(2,5,last-1,1).setFormulaR1C1('=IF(data_raw!RC1="","",data_raw!RC4)');
    web.getRange(2,6,last-1,1).setFormulaR1C1('=IF(RC2="","",RC5&" | "&RC4&" | "&RC3)');
    web.getRange(2,7,last-1,1).setFormulaR1C1('=IF(RC2="","",RC5&" est répertorié en "&RC4&" pour le pays "&RC3&" ("&RC2&").")');
    web.getRange(1,1,last,7).createFilter();
  }

  SpreadsheetApp.flush();
  Logger.log("Sheet créée : " + ss.getUrl());
}
