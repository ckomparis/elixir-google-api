<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>plg_system_sensogpt</name>
    <author>SensoGPT</author>
    <creationDate>2026-05-13</creationDate>
    <version>0.2.1</version>
    <description>PLG_SYSTEM_SENSOGPT_XML_DESCRIPTION</description>

    <namespace path="src">SensoGPT\Plugin\System\SensoGPT</namespace>

    <files>
        <folder plugin="sensogpt">services</folder>
        <folder>src</folder>
        <folder>language</folder>
        <filename plugin="sensogpt">sensogpt.php</filename>
    </files>

    <languages>
        <language tag="en-GB">language/en-GB/plg_system_sensogpt.ini</language>
        <language tag="en-GB">language/en-GB/plg_system_sensogpt.sys.ini</language>
    </languages>

    <config>
        <fields name="params">
            <fieldset name="basic" label="PLG_SYSTEM_SENSOGPT_FIELDSET_BASIC">
                <field name="enabled" type="radio" default="1" label="PLG_SYSTEM_SENSOGPT_ENABLED_LABEL" description="PLG_SYSTEM_SENSOGPT_ENABLED_DESC" class="btn-group btn-group-yesno">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field name="start_tag" type="text" default="{gpt}" label="PLG_SYSTEM_SENSOGPT_START_TAG_LABEL" description="PLG_SYSTEM_SENSOGPT_START_TAG_DESC" />
                <field name="end_tag" type="text" default="{/gpt}" label="PLG_SYSTEM_SENSOGPT_END_TAG_LABEL" description="PLG_SYSTEM_SENSOGPT_END_TAG_DESC" />
                <field name="target_language" type="text" default="en" label="PLG_SYSTEM_SENSOGPT_TARGET_LANGUAGE_LABEL" description="PLG_SYSTEM_SENSOGPT_TARGET_LANGUAGE_DESC" />
                <field name="translate_alt" type="radio" default="1" label="PLG_SYSTEM_SENSOGPT_TRANSLATE_ALT_LABEL" description="PLG_SYSTEM_SENSOGPT_TRANSLATE_ALT_DESC" class="btn-group btn-group-yesno">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
